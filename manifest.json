{
  "manifest_version": 3,
  "name": "IMDb Watchlist Checker",
  "version": "0.1.0",
  "description": "Shows a checkmark next to films on IMDb person pages when they are on your Watchlist.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://*.imdb.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/config.js",
      "src/lib/browser.js",
      "src/lib/parse-watchlist.js",
      "src/lib/store.js",
      "src/lib/sync.js",
      "src/lib/validate-message.js",
      "src/background.js"
    ]
  },
  "action": { "default_popup": "src/popup.html" },
  "content_scripts": [
    {
      "matches": ["https://*.imdb.com/name/*"],
      "js": [
        "src/config.js",
        "src/lib/browser.js",
        "src/lib/extract-ids.js",
        "src/lib/decorate.js",
        "src/content-name.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.imdb.com/title/*"],
      "js": [
        "src/config.js",
        "src/lib/browser.js",
        "src/lib/extract-ids.js",
        "src/content-title.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "imdb-watchlist-checker@local" }
  }
}
